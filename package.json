{
  "name": "aletheia",
  "version": "1.0.0",
  "description": "AI-Powered Context Analysis Chrome Extension",
  "scripts": {
    "lint": "eslint extensions/ --max-warnings 0",
    "lint:fix": "eslint extensions/ --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:chrome": "vitest run tests/unit/chrome/",
    "test:unit:firefox": "vitest run tests/unit/firefox/",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:waf": "playwright test tests/e2e/waf-integration.spec.js",
    "test:visual": "npx playwright test tests/e2e/visual-poc.spec.js",
    "test:visual:update": "npx playwright test tests/e2e/visual-poc.spec.js --update-snapshots",
    "test:a11y": "npx playwright test tests/e2e/accessibility.spec.js",
    "test:a11y:ci": "pa11y-ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.40.0",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.0.0",
    "jsdom": "^26.0.0",
    "pa11y": "^9.0.1",
    "pa11y-ci": "^4.0.1",
    "serve": "^14.2.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "playwright.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martymcenroe/Aletheia.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/martymcenroe/Aletheia/issues"
  },
  "homepage": "https://github.com/martymcenroe/Aletheia#readme"
}
