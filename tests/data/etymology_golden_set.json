  "extraction_test_cases": [
    {
      "id": "clean_json",
      "raw_response": "{\"signal\": \"Test Signal\", \"gem\": \"A test gem.\", \"context\": \"Test context here.\"}",
      "expected_signal": "Test Signal",
      "should_extract": true
    },
    {
      "id": "markdown_wrapped",
      "raw_response": "```json\n{\"signal\": \"Wrapped Signal\", \"gem\": \"Wrapped gem.\", \"context\": \"Wrapped context.\"}\n```",
      "expected_signal": "Wrapped Signal",
      "should_extract": true
    },
    {
      "id": "markdown_no_lang",
      "raw_response": "```\n{\"signal\": \"No Lang\", \"gem\": \"No language tag.\", \"context\": \"Still valid.\"}\n```",
      "expected_signal": "No Lang",
      "should_extract": true
    },
    {
      "id": "chatter_prefix",
      "raw_response": "Here is the analysis of the term:\n\n{\"signal\": \"Chatter Test\", \"gem\": \"After chatter.\", \"context\": \"The extractor should find this.\"}",
      "expected_signal": "Chatter Test",
      "should_extract": true
    },
    {
      "id": "chatter_suffix",
      "raw_response": "{\"signal\": \"Suffix Test\", \"gem\": \"Before suffix.\", \"context\": \"Valid JSON here.\"}\n\nI hope this helps!",
      "expected_signal": "Suffix Test",
      "should_extract": true
    },
    {
      "id": "no_json",
      "raw_response": "This response contains no JSON at all, just plain text explanation.",
      "expected_signal": null,
      "should_extract": false
    },
    {
      "id": "malformed_json",
      "raw_response": "{\"signal\": \"Broken, \"gem\": missing quote}",
      "expected_signal": null,
      "should_extract": false
    },
    {
      "id": "nested_braces",
      "raw_response": "Analysis: {\"signal\": \"Nested Test\", \"gem\": \"Has {braces} inside.\", \"context\": \"Context with {more} braces.\"}",
      "expected_signal": "Nested Test",
      "should_extract": true
    }
  ],
  "validation_test_cases": [
    {
      "id": "valid_complete",
      "response": {"signal": "Valid Signal", "gem": "A valid gem sentence.", "context": "First sentence. Second sentence. Third sentence."},
      "expected_valid": true
    },
    {
      "id": "missing_signal",
      "response": {"gem": "Missing signal field.", "context": "Context present."},
      "expected_valid": false
    },
    {
      "id": "missing_gem",
      "response": {"signal": "Has signal", "context": "But no gem."},
      "expected_valid": false
    },
    {
      "id": "missing_context",
      "response": {"signal": "Has signal", "gem": "Has gem."},
      "expected_valid": false
    },
    {
      "id": "empty_signal",
      "response": {"signal": "", "gem": "Gem here.", "context": "Context here."},
      "expected_valid": false
    },
    {
      "id": "signal_too_long",
      "response": {"signal": "This signal is way too long and has many many many words that exceed the fifteen word limit we set", "gem": "Short gem.", "context": "Short context."},
      "expected_valid": false
    }
  ]
}
