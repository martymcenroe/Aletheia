{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(TZ='America/Chicago' date:*)",
      "Bash(git check-ignore:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(powershell.exe -Command \"Get-Date -Format ''yyyy-MM-dd''\")",
      "Bash(python tools/print_most_recent_open_issues.py:*)",
      "Bash(poetry add:*)",
      "Bash(poetry run python:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
