          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/bash-gate.sh",
            "timeout": 5,
            "description": "Bash Command Gate (blocks &&, |, ;)"
          },
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/pre-commit-report-check.sh",
            "timeout": 5,
            "description": "PRE-COMMIT GATE: Report Existence"
          },
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/pre-store-submit.sh",
