{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/path-gate.sh",
            "timeout": 5,
            "description": "Path Gate (blocks ~ tilde paths)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/path-gate.sh",
            "timeout": 5,
            "description": "Path Gate (blocks ~ tilde paths)"
          },
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/pre-edit-check.sh",
            "timeout": 5,
            "description": "Branch Protection (Worktree Isolation)"
          },
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/pre-edit-security-warn.sh",
            "timeout": 10,
            "description": "Security Pattern Warning (OWASP)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/secret-guard.sh",
            "timeout": 5,
