{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/pre-edit-check.sh",
            "timeout": 5,
            "description": "Branch Protection (ADR 0210)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/Aletheia/.claude/hooks/post-edit-lint.sh",
            "timeout": 30,
            "description": "Security Lint (eslint/ruff)"
          }
        ]
      }
    ]
  }
}
